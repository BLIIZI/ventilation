# 5. ПОТЕРИ
wsL = wb.create_sheet('5 Потери')
wsL.cell(row=1, column=1, value='Потери давления на каждом элементе сети — режим пусконаладки: 3 поста по 1500 м³/ч').font = f_h
c = wsL.cell(row=2, column=1, value=(
    'Общая формула: Δp = ζ·p_д, p_д = ρw²/2 (динамическое давление), w = Q/F. Для воздуховода ζ = λ·l/d (трение), λ — по Альтшулю: λ = 0,11·(kэ/d + 68/Re)^0,25. '
    'Для тройников ζ отнесён к скорости в ОБЩЕМ (сборном) канале — поэтому для них w и p_д считаются по d_с и Q_с. '
    'Расходы постов (синие, колонка G в строках «зонт») — это решение сети из ядра при углах заслонок пусконаладки; Excel их не решает, а ПРОВЕРЯЕТ: '
    'сумма потерь по пути каждого поста должна равняться давлению вентилятора (лист 6). Расходы участков коллектора — сумма постов (закон сохранения массы).'))
c.font = f_i; c.alignment = WRAP; wsL.merge_cells('A2:T2'); wsL.row_dimensions[2].height = 75
cols = ['№', 'Участок', 'Элемент', 'Тип', 'd (d₁), м', 'l, м', 'Q, м³/ч', 'Q_с, м³/ч (общий канал)', 'Q_б, м³/ч (боковой поток)', 'Параметр 1', 'Параметр 2',
        'd расч., м', 'w, м/с', 'Re', 'λ', 'ζ', 'p_д, Па', 'Δp, Па (Excel)', 'Δp, Па (ядро)', 'Разница, Па', 'Формула ζ / пояснение', 'Источник', 'k_Re (отвод) / ζ₂ (диффузор)', 'k_Δ (отвод)']
header(wsL, 4, cols)
setw(wsL, [4, 9, 12, 12, 8, 6, 9, 10, 10, 11, 11, 8, 8, 10, 8, 9, 9, 10, 10, 9, 60, 34, 12, 12])
wsL.freeze_panes = 'E5'
r0 = 5
els = E['els']
postQrow = {}   # участок -> строка, где записан его расход
segrows = {}
seg_first = {}
row = r0
# ячейки с параметрами из листа «Исходные»
RHO, NU, KE = REF['rho'], REF['nu'], REF['ke']
BEND = {'bend90_': (90, 1.5, 'отвод 90°, R/D = 1,5'), 'bend45_': (45, 1.5, 'отвод 45°, R/D = 1,5'), 'bend_end': (90, 1.0, 'отвод 90°, R/D = 1 (в торец коллектора)'),
        'bend_main': (90, 1.5, 'отвод 90° к фильтру'), 'bend_out': (90, 1.5, 'отвод 90° на выбросе')}
SEGQ = {}  # участок -> адрес ячейки расхода участка


def segflow_formula(seg):
    if seg.startswith('post'):
        return None
    if seg == 'c1': return f'={SEGQ["post1"]}'
    if seg == 'c2': return f'={SEGQ["c1"]}+{SEGQ["post2"]}'
    if seg == 'c3': return f'={SEGQ["c2"]}+{SEGQ["post3"]}'
    if seg == 'common': return f'={SEGQ["c3"]}'


PARENT = {'post1': 'c1', 'post2': 'c2', 'post3': 'c3', 'c1': 'c2', 'c2': 'c3', 'c3': None}
FIRST = {}
for idx, e in enumerate(els):
    if e['seg'] not in FIRST:
        FIRST[e['seg']] = r0 + idx; SEGQ[e['seg']] = f'$G${r0 + idx}'
n = 0
for e in els:
    n += 1; r = row; seg = e['seg']; k = e['kind']; eid = e['id']
    put = lambda col, v, font=f_fx, fmt=None: (wsL.cell(row=r, column=col, value=v), setattr(wsL.cell(row=r, column=col), 'font', font), fmt and setattr(wsL.cell(row=r, column=col), 'number_format', fmt))
    put(1, n, f_n); put(2, seg, f_n); put(3, eid, f_n); put(4, k, f_n)
    # расход участка
    if FIRST[seg] == r:
        if seg.startswith('post'):
            put(7, round(e['Q'] * 3600, 4), f_in, '0.0'); wsL.cell(row=r, column=7).fill = fill_eng
            wsL.cell(row=r, column=7).comment = Comment('Расход поста — решение сети в ядре (метод Ньютона) при углах заслонок пусконаладки. Проверка правильности — баланс давлений на листе 6.', 'model')
        else:
            put(7, segflow_formula(seg), f_fx, '0.0')
    else:
        put(7, f'={SEGQ[seg]}', f_fx, '0.0')
    Qc = f'G{r}'
    # общий канал для тройников
    par = PARENT.get(seg)
    dc = None
    if k in ('teeSide', 'teeStraight'):
        put(8, f'={SEGQ[par]}' if k == 'teeSide' else f'=G{r}+I{r}', f_fx, '0.0')
    if k == 'teeStraight':
        side = e['side']
        put(9, f'={SEGQ[side]}' if side in SEGQ else None, f_fx, '0.0')
    d = e.get('d', e.get('d1', e.get('db')))
    if k == 'filter':
        d = None
    if d is not None:
        put(5, d, f_in, '0.000'); wsL.cell(row=r, column=5).fill = fill_in
    expl = ''; src = ''
    if k == 'duct':
        put(6, e['l'], f_in, '0.0'); wsL.cell(row=r, column=6).fill = fill_in
        put(12, f'=E{r}', f_fx, '0.000')
        expl = 'Трение по длине: ζ = λ·l/d. λ: Re ≤ 2000 — 64/Re; Re ≥ 4000 — Альтшуль 0,11(kэ/d + 68/Re)^0,25; между — линейно (чтобы λ была непрерывной).'
        src = 'Дарси–Вейсбах; Альтшуль А.Д., 1982 [С]'
    elif k == 'bend':
        put(12, f'=E{r}', f_fx, '0.000')
        put(10, e['delta'], f_in, '0'); put(11, e['rd'], f_in, '0.0'); wsL.cell(row=r, column=10).fill = fill_in; wsL.cell(row=r, column=11).fill = fill_in
        expl = (f"{e.get('label', 'отвод')}. Стальной (шероховатый) воздуховод, п. 2 диагр. 6-1: ζ = k_Δ·k_Re·A₁·B₁. A₁ — по таблице (лист 4), B₁ = 0,21/(R/D)^2,5 при R/D ≤ 1, 0,21/(R/D)^0,5 при R/D > 1. "
                "k_Re = 1,3 − 0,29·ln(Re·10⁻⁵) при R/D > 0,7. k_Δ: Re 4·10⁴…2·10⁵ — λ_Δ/λ_гл (λ_гл = 1/(1,8 lg Re − 1,64)²), > 2·10⁵ — 1 + Δ̄·10³, сглажено по ln Re на границах [М]. Колонки W, X — k_Re, k_Δ. Параметр 1 = δ, °; 2 = R/D.")
        src = 'Идельчик, 1992, диагр. 6-1, с. 277–278 [С] — сверено'
    elif k == 'local':
        put(12, f'=E{r}', f_fx, '0.000')
        bk = None
        if bk:
            dl, rd, lab = BEND[bk]
            put(10, dl, f_in, '0'); put(11, rd, f_in, '0.0'); wsL.cell(row=r, column=10).fill = fill_in; wsL.cell(row=r, column=11).fill = fill_in
            expl = f'{lab}. ζ = A₁·B₁; A₁ = 1,634831·10⁻⁷δ³ − 8,1581126·10⁻⁵δ² + 1,714184·10⁻²δ (A₁(90°) = 1,00); B₁ = 0,21/(R/D)^2,5 при R/D < 1, 0,21/(R/D)^0,5 при R/D ≥ 1. Параметр 1 = δ, °; параметр 2 = R/D.'
            src = 'Идельчик И.Е., 1992, разд. 6, диагр. 6-1 [С][П]'
        elif eid.startswith('hood'):
            put(10, 0.2, f_in, '0.00'); wsL.cell(row=r, column=10).fill = fill_in
            expl = 'Вход через конический коллектор (раструб) α = 60°: ζ = 0,25 при l/D = 0,15 и 0,17 при l/D = 0,25 — принято 0,2 (параметр 1). Без раструба (острая кромка) — 0,5.'
            src = 'Идельчик, 1992, диагр. 3-6, с. 127 [С] — сверено; геометрия [Д]'
        elif eid == 'exit':
            put(10, 1.0, f_in, '0.00'); wsL.cell(row=r, column=10).fill = fill_in
            expl = 'Выход в атмосферу: теряется вся скорость, ζ = 1 (параметр 1).'
            src = 'Идельчик, 1992 [С]'
    elif k == 'damper':
        ang = list(E['angles'].values())[int(seg[-1]) - 1]
        put(10, round(ang, 6), f_in, '0.00'); wsL.cell(row=r, column=10).fill = fill_eng
        wsL.cell(row=r, column=10).comment = Comment('Угол заслонки после пусконаладки (балансировки) — посчитан в ядре (balance.ts).', 'model')
        put(12, f'=E{r}', f_fx, '0.000')
        expl = 'Дроссель-клапан: ζ(α) по таблице листа «4 Таблицы» с интерполяцией по ln ζ. Параметр 1 = угол α, °.'
        src = 'Идельчик, 1992, диагр. 9-17, кривая 2 [С] — сверено'
    elif k == 'diffuser':
        put(10, e['d2'], f_in, '0.000'); put(11, e.get('alpha', 15), f_in, '0'); wsL.cell(row=r, column=10).fill = fill_in; wsL.cell(row=r, column=11).fill = fill_in
        put(12, f'=E{r}', f_fx, '0.000')
        expl = ('Переход на больший диаметр (диффузор), к скорости в узком сечении d₁. n = (d₂/d₁)². ζ₂ — таблица при n = 2 (лист 4) по α и Re (интерполяция по α и ln Re); '
                'пересчёт на n по формулам Идельчика (5-6), (5-7): ζ = (ζ₂ − ζ_тр(2))·((1 − 1/n)/0,5)^1,92 + ζ_тр(n), ζ_тр = λ/(8 sin(α/2))·(1 − 1/n²) [М]. Колонка W — ζ₂. Параметр 1 = d₂, м; 2 = α, °.')
        src = 'Идельчик, 1992, диагр. 5-2, с. 211; ф. (5-6), (5-7), с. 192–193 [С] — сверено'
    elif k == 'teeSide':
        put(10, e['dc'], f_in, '0.000'); wsL.cell(row=r, column=10).fill = fill_in
        put(12, f'=J{r}', f_fx, '0.000')
        expl = ('Тройник на слияние, боковой вход. r = Q_б/Q_с. ζ = A·[1 + (r·F_с/F_б)² − 2(1 − r)²], к скорости в общем канале d_с (параметр 1). '
                'A: F_б/F_с ≤ 0,35 → 1; иначе max(0,9(1 − r); 0,55). Может быть < 0 (эжекция) — это физика.')
        src = 'Идельчик, 1992, диагр. 7-4, с. 346; A — табл. 7-1, с. 335 [С] — сверено'
    elif k == 'teeStraight':
        put(5, e['dc'], f_in, '0.000'); wsL.cell(row=r, column=5).fill = fill_in
        put(12, f'=E{r}', f_fx, '0.000')
        expl = 'Тройник на слияние, проход. r = Q_б/Q_с (Q_б — боковой поток, колонка I). ζ = 1,55·r − r², к скорости в общем канале (d = d_с).'
        src = 'Идельчик, 1992, диагр. 7-4, с. 346 [С] — сверено'
    elif k == 'filter':
        sp = e['spec']
        put(10, sp['dpNom'], f_in, '0'); put(11, round(sp['qNom'] * 3600, 3), f_in, '0'); wsL.cell(row=r, column=10).fill = fill_in; wsL.cell(row=r, column=11).fill = fill_in
        expl = 'Фильтр: Δp = Δp_ном·(Q/Q_ном)^m, m = 1 (закон Дарси для фильтровальной перегородки). Параметр 1 = Δp_ном, Па; параметр 2 = Q_ном, м³/ч. Чистый фильтр (k_загр = 1).'
        src = 'Ужов В.Н., Мягков Б.И., 1970 [С]; Δp_ном — паспорт [Д]'
    # скорость, Re, λ, ζ, pд, Δp
    LAMF = 'IF(N{r}<=2000,64/N{r},IF(N{r}>=4000,0.11*({KE}/L{r}+68/N{r})^0.25,(1-(N{r}-2000)/2000)*64/2000+(N{r}-2000)/2000*0.11*({KE}/L{r}+68/4000)^0.25))'
    Qsec = f'H{r}' if k in ('teeSide', 'teeStraight') else f'G{r}'
    if k != 'filter':
        put(13, f'={Qsec}/3600/(PI()*L{r}^2/4)', f_fx, '0.00')
        put(14, f'=M{r}*L{r}/{NU}', f_fx, '0')
        put(17, f'={RHO}*M{r}^2/2', f_fx, '0.00')
    if k == 'duct':
        put(15, f'=IF(N{r}<=2000,64/N{r},IF(N{r}>=4000,0.11*({KE}/E{r}+68/N{r})^0.25,(1-(N{r}-2000)/2000)*64/2000+(N{r}-2000)/2000*0.11*({KE}/E{r}+68/4000)^0.25))', f_fx, '0.0000')
        put(16, f'=O{r}*F{r}/E{r}', f_fx, '0.000')
    elif k == 'bend':
        put(15, '=' + LAMF.format(r=r, KE=KE), f_fx, '0.0000')
        put(23, f'=IF(K{r}>0.7,1.3-0.29*LN(MAX(N{r},1E4)*1E-5),IF(K{r}>0.55,5.45/MAX(N{r},1E4)^0.131,1+4400/MAX(N{r},1E4)))', f_fx, '0.0000')
        mid = f'(O{r}*(1.8*LOG10(MAX(N{r},4000))-1.64)^2)'; hi = f'(1+MIN({KE}/L{r},0.001)*1000)'
        bl = lambda x0, x1, y0, y1: f'({y0}+MIN(1,MAX(0,LN(N{r}/{x0})/LN({x1}/{x0})))*({y1}-{y0}))'
        put(24, f'=IF(N{r}<=32000,1,IF(N{r}<50000,{bl(32000, 50000, 1, mid)},IF(N{r}<=160000,{mid},IF(N{r}<250000,{bl(160000, 250000, mid, hi)},{hi}))))', f_fx, '0.0000')
        ia = f'MATCH(J{r},{A1A},1)'
        a1 = f'IF(J{r}>=180,1.4,INDEX({A1B},{ia})+(J{r}-INDEX({A1A},{ia}))*(INDEX({A1B},{ia}+1)-INDEX({A1B},{ia}))/(INDEX({A1A},{ia}+1)-INDEX({A1A},{ia})))'
        put(16, f'=X{r}*W{r}*{a1}*IF(K{r}<=1,0.21/K{r}^2.5,0.21/K{r}^0.5)', f_fx, '0.000')
    elif k == 'local':
        if False:
            put(16, f'=(1.634831E-7*J{r}^3-8.1581126E-5*J{r}^2+1.714184E-2*J{r})*IF(K{r}<1,0.21/K{r}^2.5,0.21/K{r}^0.5)', f_fx, '0.000')
        else:
            put(16, f'=J{r}', f_fx, '0.000')
    elif k == 'damper':
        put(16, zeta_damper(f'J{r}'), f_fx, '0.000')
    elif k == 'diffuser':
        put(15, '=' + LAMF.format(r=r, KE=KE), f_fx, '0.0000')
        # ζ₂(α, Re) при n = 2: интерполяция по α в двух соседних строках Re, затем по ln Re
        lr = f'LN(MIN(MAX(N{r},50000),400000))'
        ir = f'MIN(MATCH({lr},{DT_LR},1),3)'
        ia2 = f'MIN(MATCH(K{r},{DT_A},1),14)'
        def za(rowk):
            rng = f"OFFSET('4 Таблицы'!$C$33,{rowk},0,1,15)"
            return f'(INDEX({rng},1,{ia2})+(K{r}-INDEX({DT_A},1,{ia2}))*(INDEX({rng},1,{ia2}+1)-INDEX({rng},1,{ia2}))/(INDEX({DT_A},1,{ia2}+1)-INDEX({DT_A},1,{ia2})))'
        z0 = za(f'{ir}-1'); z1 = za(ir)
        put(23, f'={z0}+({lr}-INDEX({DT_LR},{ir}))/(INDEX({DT_LR},{ir}+1)-INDEX({DT_LR},{ir}))*({z1}-{z0})', f_fx, '0.0000')
        fr = lambda nn: f'(O{r}/(8*SIN(RADIANS(K{r}/2)))*(1-1/({nn})^2))'
        n_ = f'((J{r}/E{r})^2)'
        put(16, f'=MAX(0,W{r}-{fr(2)})*((1-1/{n_})/0.5)^1.92+{fr(n_)}', f_fx, '0.0000')
    elif k == 'teeSide':
        rr = f'(G{r}/H{r})'
        put(16, f'=IF((E{r}/J{r})^2<=0.35,1,MAX(0.9*(1-{rr}),0.55))*(1+({rr}*(J{r}/E{r})^2)^2-2*(1-{rr})^2)', f_fx, '0.000')
    elif k == 'teeStraight':
        rr = f'(I{r}/H{r})'
        put(16, f'=1.55*{rr}-{rr}^2', f_fx, '0.000')
    if k == 'filter':
        put(18, f'=J{r}*(G{r}/K{r})', f_fx, '0.00')
    else:
        put(18, f'=P{r}*Q{r}', f_fx, '0.00')
    put(19, round(e['dp'], 6), f_in, '0.00'); wsL.cell(row=r, column=19).fill = fill_eng
    put(20, f'=R{r}-S{r}', f_fx, '0.0000')
    put(21, expl, f_n); put(22, src, f_n)
    for j in range(1, 25):
        wsL.cell(row=r, column=j).border = BOX
        if j >= 21: wsL.cell(row=r, column=j).alignment = WRAP
    segrows.setdefault(seg, []).append(r)
    row += 1
last = row - 1
# суммы по участкам и путям
row += 1
wsL.cell(row=row, column=2, value='Суммы потерь по участкам и путям').font = f_b; row += 1
header(wsL, row, ['', 'Участок / путь', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', 'Σ Δp, Па (Excel)', 'Σ Δp, Па (ядро)', 'Разница', 'Пояснение'])
row += 1
SEGSUM = {}
for seg in ['post1', 'c1', 'post2', 'c2', 'post3', 'c3', 'common']:
    wsL.cell(row=row, column=2, value=seg).font = f_n
    wsL.cell(row=row, column=18, value=f'=SUMIF($B${r0}:$B${last},B{row},$R${r0}:$R${last})').font = f_fx
    wsL.cell(row=row, column=19, value=f'=SUMIF($B${r0}:$B${last},B{row},$S${r0}:$S${last})').font = f_fx
    wsL.cell(row=row, column=20, value=f'=R{row}-S{row}').font = f_fx
    for j in (18, 19, 20): wsL.cell(row=row, column=j).number_format = '0.00'
    SEGSUM[seg] = f'R{row}'; row += 1
PATHS = {'post1': ['post1', 'c1', 'c2', 'c3'], 'post2': ['post2', 'c2', 'c3'], 'post3': ['post3', 'c3']}
row += 1
for p, segs in PATHS.items():
    wsL.cell(row=row, column=2, value=f'Путь {p} → вентилятор + общий тракт').font = f_b
    wsL.cell(row=row, column=18, value='=' + '+'.join(SEGSUM[s] for s in segs) + '+' + SEGSUM['common']).font = f_fx
    wsL.cell(row=row, column=18).number_format = '0.00'
    wsL.cell(row=row, column=21, value='Полные потери от входа в зонт поста до выброса. По закону сохранения энергии = давлению вентилятора (сверка на листе 6). Если у разных постов суммы разные — расходы не являются решением сети.').alignment = WRAP
    REF['path_' + p] = q('5 Потери') + f'!$R${row}'
    row += 1
REF['Qtot_L'] = q('5 Потери') + '!' + SEGQ['common'].replace('$G$', '$G$')
REF['Qtot_L'] = q('5 Потери') + '!' + SEGQ['common']
REF['dpmaxdiff'] = q('5 Потери') + f'!$T${r0}:$T${last}'
wsL.cell(row=row + 1, column=2, value='Наибольшее расхождение по элементу, Па:').font = f_b
wsL.cell(row=row + 1, column=18, value=f'=MAX(ABS(MAX(T{r0}:T{last})),ABS(MIN(T{r0}:T{last})))').font = f_fx
wsL.cell(row=row + 1, column=18).number_format = '0.000000'
REF['dpdiff'] = q('5 Потери') + f'!$R${row + 1}'
# скорость: проверка транспортной
wsL.cell(row=row + 2, column=2, value='Наименьшая скорость в воздуховодах, м/с (норма ≥ 8):').font = f_b
wsL.cell(row=row + 2, column=18, value=f'=MIN(M{r0}:M{last})').font = f_fx
wsL.cell(row=row + 2, column=18).number_format = '0.00'

# =====================================================================================================
# 6. ВЕНТИЛЯТОР
fan = E['fan']
S = CalcSheet('6 Вентилятор', 'Вентилятор: давление, мощность, КПД привода',
              'Давление вентилятора при частоте n — по каталожной характеристике (при n₀) и законам подобия: Q ~ n, p ~ n². Мощность на валу N = Q·p/η. Электрическая мощность — с учётом КПД двигателя и частотника.')
S.section('Характеристика вентилятора при n₀ (демо [Д] — заменить каталогом)')
hr = S.r
for j, h in enumerate(['Q₀, м³/ч', 'p₀, Па'], 2):
    x = S.ws.cell(row=hr, column=j, value=h); x.font = f_b; x.fill = fill_hd
S.r += 1
fr0 = S.r
for qq, pp in fan['points']:
    S.ws.cell(row=S.r, column=2, value=qq).font = f_in; S.ws.cell(row=S.r, column=2).fill = fill_in
    S.ws.cell(row=S.r, column=3, value=pp).font = f_in; S.ws.cell(row=S.r, column=3).fill = fill_in
    S.r += 1
fr1 = S.r - 1
FQ = f"'6 Вентилятор'!$B${fr0}:$B${fr1}"; FP = f"'6 Вентилятор'!$C${fr0}:$C${fr1}"
S.r += 1
S.add('n0', 'Частота каталожной характеристики', 'n₀', fan['n0'], 'об/мин', '', '', 'каталог [Д]', 'in', '0')
S.add('n', 'Частота после пусконаладки', 'n', round(E['n'], 6), 'об/мин', '', 'Минимальная частота, при которой все посты получают 1500 м³/ч (подобрано ядром, balance.ts).', 'ядро', 'eng', '0.0')
S.add('Qt', 'Общий расход', 'Q', '=' + REF['Qtot_L'], 'м³/ч', 'Q = ΣQ_пост', '', 'лист 5')
S.add('kf', 'Отношение частот', 'k', '={n}/{n0}', '—', 'k = n/n₀', '', '')
S.add('Q0', 'Расход, приведённый к n₀', 'Q₀', '={Qt}/{kf}', 'м³/ч', 'Q₀ = Q/k', 'По закону подобия расход пропорционален частоте.', 'ГОСТ 10921-2017, разд. 14 [Н]')
i = f'MATCH({{Q0}},{FQ},1)'
S.add('p0', 'Давление по характеристике при n₀', 'p₀', ('=INDEX(' + FP + ',' + i + ')+({Q0}-INDEX(' + FQ + ',' + i + '))*(INDEX(' + FP + ',' + i + '+1)-INDEX(' + FP + ',' + i + '))/(INDEX(' + FQ + ',' + i + '+1)-INDEX(' + FQ + ',' + i + '))'),
      'Па', 'линейная интерполяция по таблице', '', '')
S.add('pfan', 'Давление вентилятора при n', 'p', '={p0}*{kf}^2', 'Па', 'p = p₀·k²', 'Давление пропорционально квадрату частоты.', 'ГОСТ 10921-2017, разд. 14 [Н]')
S.section('Проверка баланса: давление вентилятора = потери по пути каждого поста')
S.add('b1', 'Путь поста 1 − давление вентилятора', '', '=' + REF['path_post1'] + '-{pfan}', 'Па', 'Σ Δp − p', 'Должно быть ≈ 0 (± 0,01 Па): расходы — действительно решение сети.', 'закон сохранения энергии')
S.add('b2', 'Путь поста 2 − давление вентилятора', '', '=' + REF['path_post2'] + '-{pfan}', 'Па', '', '', '')
S.add('b3', 'Путь поста 3 − давление вентилятора', '', '=' + REF['path_post3'] + '-{pfan}', 'Па', '', '', '')
S.section('Мощность')
S.add('etaf', 'КПД вентилятора', 'η_в', fan['eta'], '—', '', 'Принят постоянным [Д] — уточнить по каталогу.', '[Д]', 'in', '0.00')
S.add('N', 'Мощность на валу', 'N', '={Qt}/3600*{pfan}/{etaf}', 'Вт', 'N = Q·p/η_в', '', 'Калинушкин М.П., 1979 [С]')
S.add('Pn', 'Номинальная мощность двигателя', 'P_н', fan['motorW'], 'Вт', '', '', 'демо [Д]', 'in', '0')
S.add('etan', 'Номинальный КПД двигателя (IE3, 4 полюса, 2,2 кВт)', 'η_н', fan['motorEta'], '—', '', '', 'ГОСТ IEC 60034-30-1-2016, табл. 1 [Н]', 'in', '0.000')
S.add('beta', 'Загрузка двигателя', 'β', '={N}/{Pn}', '—', 'β = N/P_н', '', '')
S.add('kl', 'Отношение постоянных потерь к переменным', 'k_п', 0.5, '—', '', 'Постоянные потери (сталь, трение) не зависят от нагрузки, переменные (медь) ~ β².', 'Копылов И.П. Электрические машины [С][П]', 'in', '0.00')
S.add('etam', 'КПД двигателя при загрузке β', 'η_дв', '={beta}/({beta}+(1/{etan}-1)*({kl}+{beta}^2)/(1+{kl}))', '—', 'η = β/(β + ΣP(β)), ΣP = ΣP_н·(k + β²)/(1 + k)', 'При недогрузке КПД двигателя падает.', 'Копылов [С]')
S.add('etav', 'КПД частотника при загрузке β', 'η_ПЧ', None, '—', 'интерполяция таблицы', 'Российского числового норматива нет (метод — ГОСТ IEC 61800-9-2-2021); до паспорта ПЧ — типовые значения US DOE (зарубежный справочный).', '[Д]')
VT = [[0.016, 0.35], [0.125, 0.80], [0.25, 0.88], [0.42, 0.91], [0.5, 0.92], [0.75, 0.94], [1.0, 0.95]]
vr = S.r + 1
S.ws.cell(row=vr, column=2, value='Таблица КПД ПЧ: β →').font = f_b
for j, (b, ev) in enumerate(VT):
    S.ws.cell(row=vr, column=3 + j, value=b).font = f_in; S.ws.cell(row=vr + 1, column=3 + j, value=ev).font = f_in
VB = f"'6 Вентилятор'!$C${vr}:$I${vr}"; VE = f"'6 Вентилятор'!$C${vr + 1}:$I${vr + 1}"
iv = f'MATCH({REF["beta"]},{VB},1)'
etav_row = int(REF['etav'].split('$')[-1])
S.ws.cell(row=etav_row, column=4, value=(f'=IF({REF["beta"]}<=0.016,0.35,IF({REF["beta"]}>=1,0.95,INDEX({VE},{iv})+({REF["beta"]}-INDEX({VB},{iv}))*(INDEX({VE},{iv}+1)-INDEX({VE},{iv}))/(INDEX({VB},{iv}+1)-INDEX({VB},{iv}))))')).font = f_fx
S.ws.cell(row=etav_row, column=4).number_format = '0.000'
S.r = vr + 3
S.add('Pel', 'Электрическая мощность из сети', 'P_эл', '={N}/({etam}*{etav})', 'Вт', 'P_эл = N/(η_дв·η_ПЧ)', 'Это то, что покажет счётчик.', '')

# =====================================================================================================
# 7. ТЕПЛО
S = CalcSheet('7 Тепло', 'Тепло на нагрев приточного воздуха',
              'Весь воздух, удалённый из цеха (местные отсосы + общеобменная), замещается наружным, который надо нагреть до t_в. Q = ρ·c·L·(t_в − t_н).')
S.add('dT', 'Разность температур', 'Δt', '={tin}-{tout}', '°C', 'Δt = t_в − t_оп', '', 'СанПиН, СП 131.13330.2025')
S.section('Без регулирования: всё работает всю смену на расчётном расходе')
S.add('Lall', 'Весь удаляемый воздух', 'L', '={Lwz}+{Lov}', 'м³/ч', 'L = L_wz + L_оо', 'Равно L по СП 60 (лист 3).', 'лист 3')
S.add('Qh', 'Тепловая мощность', 'Φ', '={rho}*{c}*{Lall}/3600*{dT}', 'кВт', 'Φ = ρ·c·L·Δt/3600', 'Сколько киловатт тепла идёт на подогрев притока.', 'Богословский В.Н. и др. Отопление и вентиляция, 1976 [С]')
S.add('Qshift', 'Тепло за смену', 'Q_см', '={Qh}*{shift}', 'кВт·ч', 'Q = Φ·t_см', 'Сверка с ядром: режим «без регулирования» лист 9.', '')
S.add('Qseason', 'Тепло за отопительный период (1 смена/сут)', 'Q_оп', '={Qshift}*{days}/1000', 'МВт·ч', 'Q_см·z_оп', '', '')
S.add('Gcal', 'То же в гигакалориях', '', '={Qseason}/1.163', 'Гкал', '1 Гкал = 1,163 МВт·ч', 'В Гкал выставляют счёт за тепло.', '')
S.section('Сколько стоил бы «двойной учёт» воздуха отсосов (ошибка до 11.10.2026)')
S.add('Qerr', 'Лишнее тепло за смену', 'ΔQ', '={rho}*{c}*{Lover}/3600*{dT}*{shift}', 'кВт·ч', '', 'Столько тепла «лишнего» закладывал старый расчёт.', '')

# =====================================================================================================
# 8. СВЕРКА
wsC = wb.create_sheet('8 Сверка')
wsC.cell(row=1, column=1, value='Сверка: Excel против расчётного ядра').font = f_h
wsC.cell(row=2, column=1, value='Ядро — программа vent-sim (TypeScript); значения выгружены export_engine.ts в engine.json. Зелёный — расхождение < 0,1 %.').font = f_i
header(wsC, 4, ['Величина', 'Excel', 'Ядро', 'Относит. разница', 'Итог'])
setw(wsC, [60, 14, 14, 16, 8])
CH = [
    ('Коэффициент расплавления α_р, г/(А·ч), 225 А', REF['alpha'], E['alpha225']),
    ('Расход проволоки B, кг/ч, 225 А', REF['B'], E['B225']),
    ('Весь воздухообмен L по СП 60, м³/ч (3 поста, 225 А)', REF['L'], E['Ltot3']),
    ('Общеобменная L_оо = L − L_wz, м³/ч', REF['Lov'], E['Lgen3']),
    ('Расход вентилятора, м³/ч', REF['Qt'], E['Qtotal'] * 3600),
    ('Давление вентилятора, Па', REF['pfan'], E['pFan']),
    ('Мощность на валу, Вт', REF['N'], E['power']),
    ('КПД двигателя при загрузке', REF['etam'], E['etaMotor']),
    ('Электрическая мощность, Вт', REF['Pel'], E['powerEl']),
    ('Тепло за смену без регулирования, кВт·ч', REF['Qshift'], 665.0),
]
r = 5
for lab, xl, en in CH:
    wsC.cell(row=r, column=1, value=lab).font = f_n
    wsC.cell(row=r, column=2, value='=' + xl).font = f_ln; wsC.cell(row=r, column=2).number_format = '0.000'
    wsC.cell(row=r, column=3, value=en).font = f_in; wsC.cell(row=r, column=3).fill = fill_eng; wsC.cell(row=r, column=3).number_format = '0.000'
    wsC.cell(row=r, column=4, value=f'=ABS(B{r}-C{r})/ABS(C{r})').font = f_fx; wsC.cell(row=r, column=4).number_format = '0.0000%'
    wsC.cell(row=r, column=5, value=f'=IF(D{r}<0.001,"ОК","ПРОВЕРИТЬ")').font = f_fx
    r += 1
wsC.cell(row=r, column=1, value='Тепло за смену в ядре — результат динамического расчёта (интеграл за 8 ч), округлён до 1 кВт·ч, поэтому разница до 0,1 %.').font = f_i
r += 1
for lab, xl, tol in [('Наибольшее расхождение потерь по элементу, Па', REF['dpdiff'], 1e-3), ('Баланс: путь поста 1 − давление вентилятора, Па', REF['b1'], 0.01),
                     ('Баланс: путь поста 2 − давление вентилятора, Па', REF['b2'], 0.01), ('Баланс: путь поста 3 − давление вентилятора, Па', REF['b3'], 0.01),
                     ('Проверка выделений: Σ компонентов − аэрозоль, г/кг', REF['chk_sum'], 1e-9), ('Концентрация Mn при L по СП 60 минус ПДК, мг/м³', REF['Cchk'] + '-' + REF['pdk_mn'], 1e-9)]:
    wsC.cell(row=r, column=1, value=lab).font = f_n
    wsC.cell(row=r, column=2, value='=' + xl).font = f_ln; wsC.cell(row=r, column=2).number_format = '0.000000'
    wsC.cell(row=r, column=3, value=f'допуск {tol:g}').font = f_n
    wsC.cell(row=r, column=5, value=f'=IF(ABS(B{r})<={tol},"ОК","ПРОВЕРИТЬ")').font = f_fx
    r += 1

# =====================================================================================================
# 9. РЕЗУЛЬТАТЫ СМЕНЫ (из ядра)
wsR = wb.create_sheet('9 Результаты смены')
wsR.cell(row=1, column=1, value='Итоги динамического расчёта смены 8 ч (ядро, шаг 1 с) — версия 1.7 от 11.10.2026 (фасонные элементы по Идельчику: отводы с k_Re·k_Δ, заслонка — диагр. 9-17, диффузор — диагр. 5-2)').font = f_h
c = wsR.cell(row=2, column=1, value='Эти числа получены программой: расписание сварки, регуляторы, приводы заслонок с ограниченной скоростью, частотник, решение сети на каждом шаге, '
             'нестационарная концентрация в цехе. В Excel повторить нельзя; проверяемые части (выделения, СП 60, потери, вентилятор, тепло) — на листах 2–7.')
c.font = f_i; c.alignment = WRAP; wsR.merge_cells('A2:I2'); wsR.row_dimensions[2].height = 45
setw(wsR, [44, 14, 14, 14, 14, 14, 14, 14, 14])
blocks = [
    ('А. 3 поста MAG 225 А, столы с отсосом 1500 м³/ч, общеобменная постоянная 8 101 м³/ч (по СП 60)', ['Режим местной вытяжки', 'Вент. МВВ, кВт·ч', 'Тепло, кВт·ч', 'Ср. расход МВВ, м³/ч', 'Расход < 95 %', '> 110 %', 'Mn ср., мг/м³', 'Mn макс., мг/м³'],
     [['Без регулирования', 15.06, 665, 4498, '0 %', '0 %', 0.064, 0.088], ['«Открыто/закрыто» + ПЧ (пром. стандарт)', 5.39, 527, 1872, '5,6 %', '38,4 %', 0.084, 0.111],
      ['Предлагаемая (ПИ по ln ζ + сброс давления)', 4.97, 519, 1727, '6,3 %', '2,6 %', 0.087, 0.115], ['Предлагаемая + ОВ по числу постов', 4.97, 398, 1727, '6,3 %', '2,6 %', 0.107, 0.142]]),
    ('Б. 3 поста, ток меняется 175/225/270 А; режимы общеобменной (местная — предлагаемая)', ['Режим ОВ', 'Ср. ОВ, м³/ч', 'Тепло, кВт·ч', 'Эл. МВВ+ОВ, кВт·ч', 'Mn ср.', 'Mn макс.', 'Время > ПДК', ''],
     [['Постоянный (расчётный, 270 А)', 10847, 660, 28.79, 0.068, 0.096, '0 %', ''], ['По числу работающих постов', 5344, 369, 9.44, 0.106, 0.143, '0 %', ''],
      ['Упреждение по току', 7538, 485, 6.17, 0.086, 0.111, '0 %', ''], ['Упреждение по току + датчик (цель 0,5 ПДК)', 6879, 450, 6.58, 0.089, 0.115, '0 %', ''],
      ['То же, цель 0,7 ПДК', 4160, 307, 6.01, 0.115, 0.154, '0 %', ''], ['Ошибка модели: реальный захват 70 % вместо 80 % — постоянный', 10847, 660, 28.79, 0.097, 0.137, '0 %', ''],
      ['Ошибка модели — по числу постов', 5344, 369, 9.44, 0.151, 0.205, '> ПДК', ''],
      ['Ошибка модели — упреждение без датчика', 7538, 485, 6.17, 0.122, 0.159, '0 %', ''], ['Ошибка модели — упреждение + датчик (сам добавил воздух)', 11011, 669, 12.04, 0.092, 0.123, '0 %', '']]),
    ('В. Универсальный цех, 4 вида сварки (CO₂ 225 А · УОНИ-13/45 · под флюсом АН-348-А · контактная); стационарные отсосы 1500+1500+1500+1000 = 5 500 м³/ч, ОВ по СП 60 — 962 м³/ч', ['МВВ / ОВ', 'Вент. МВВ, кВт·ч', 'Тепло, кВт·ч', 'Ср. ОВ, м³/ч', 'max Σ C/ПДК', '', '', ''],
     [['Без регулирования / пост.', 20.58, 341, 962, 0.382], ['«Открыто/закрыто» + ПЧ / пост.', 7.70, 177, 962, 0.649], ['Предлагаемая / пост.', 6.62, 163, 962, 0.708],
      ['Предлагаемая / по числу постов', 6.62, 138, 486, 0.774], ['Предлагаемая / по выделениям + датчики, цель 0,5', 6.62, 283, 3240, 0.474],
      ['то же, цель 0,8 (та же безопасность, что у пост.)', 6.62, 160, 918, 0.696], ['то же, цель 0,9', 6.62, 140, 526, 0.752]]),
]
r = 4
for title, hdr, rows_ in blocks:
    wsR.cell(row=r, column=1, value=title).font = f_b; r += 1
    header(wsR, r, hdr); r += 1
    for rw in rows_:
        for j, v in enumerate(rw, 1):
            wsR.cell(row=r, column=j, value=v).font = f_n; wsR.cell(row=r, column=j).border = BOX
        r += 1
    r += 1
concl = [
    'ВЫВОДЫ (v1.7, 11.10.2026):',
    '1. Основная экономия электроэнергии — от регулирования местной вытяжки: «открыто/закрыто» + ПЧ даёт −64 % против работы без регулирования (15,06 → 5,39 кВт·ч); предлагаемая система — ещё −8 % (4,97) и, главное, точность: перерасход 2,6 % времени против 38,4 %.',
    '2. Общеобменная по потребности — компромисс «тепло ↔ запас по ПДК». При той же безопасности, что у постоянной (max Σ C/ПДК ≈ 0,70), экономия тепла всего −2 % (163 → 160 кВт·ч, таблица В); '
    'при допуске до 0,9 ПДК — −14 % (140 кВт·ч).',
    '3. Простое регулирование «по числу работающих постов» по теплу выгодно (таблица Б: 369 кВт·ч против 660), но не защищено от ошибки модели: при захвате 70 % вместо 80 % Mn макс. 0,205 > ПДК 0,2.',
    '4. Датчик нужен для безопасности, а не для экономии: при ошибке модели система с датчиком сама добавила воздух (Mn макс. 0,123), без датчика — 0,159.',
    '5. Связь местной и общеобменной: при снижении расходов отсосов уменьшается разбавление воздуха цеха, общеобменная должна это компенсировать — аргумент за СОГЛАСОВАННОЕ управление (новизна).',
    '6. Зона дыхания сварщика: при η = 0,8 средняя концентрация Mn у лица ≈ 0,42 мг/м³ — в 5 раз выше фона цеха и выше ПДК во всех режимах; её определяет конструкция отсоса (захват), а не воздухообмен.',
    '7. Объём цеха (48×24×14,4 = 16 589 м³) в потребный расход не входит (СП 60, Г.2; 7.4.1 запрещает расчёт по кратности для рабочей зоны). Он задаёт инерцию τ = V/L ≈ 79 мин при 12 601 м³/ч — как быстро меняется концентрация и сколько времени у регуляторов.',
]
for t in concl:
    c = wsR.cell(row=r, column=1, value=t); c.font = f_b if t.startswith('ВЫВОДЫ') else f_n; c.alignment = WRAP
    wsR.merge_cells(start_row=r, start_column=1, end_row=r, end_column=9); wsR.row_dimensions[r].height = 32; r += 1

for wsx in wb.worksheets:
    wsx.sheet_view.zoomScale = 90
wb.save(OUT)
print('saved', OUT)
