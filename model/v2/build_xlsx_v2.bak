    for j, v in enumerate(row): c = wsZ.cell(row=rr, column=3 + j, value=v); c.font = f_in; c.fill = fill_in
DT_A = "'4 Таблицы'!$C$32:$Q$32"; DT_LR = "'4 Таблицы'!$B$33:$B$36"
DT_ROW = lambda k: f"'4 Таблицы'!$C${33 + k}:$Q${33 + k}"

setw(wsZ, [12, 10, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8])


def zeta_damper(acell):
    i = f'MATCH({acell},{ZA},1)'
    return (f'=IF({acell}>=90,1E4,EXP(LN(INDEX({ZB},{i}))+({acell}-INDEX({ZA},{i}))/(INDEX({ZA},{i}+1)-INDEX({ZA},{i}))'
            f'*(LN(INDEX({ZB},{i}+1))-LN(INDEX({ZB},{i})))))')


