S.add('G_mn_all', 'Выделяется на всех постах', 'ΣG_Mn', '={G_mn}*{npost}*1000', 'мг/ч', 'n·G_Mn', '', '')
S.add('G_mn_lev', 'Ловят местные отсосы', 'η·ΣG', '={eta}*{G_mn_all}', 'мг/ч', 'η·ΣG', 'Уходит через отсос → фильтр → выброс.', 'Методика 1997, разд. 2.1 [Н]')
S.add('m_po', 'Поступает в воздух цеха', 'm_по', '=(1-{eta})*{G_mn_all}', 'мг/ч', '(1 − η)·ΣG', 'Вот это и должна разбавить вентиляция — это m_по в формуле СП 60.', 'СП 60.13330.2020 (обозначение m_po) [Н]')
S.add('m_fe', 'Железа оксид в воздух цеха', 'm_Fe', '=(1-{eta})*{G_fe}*{npost}*1000', 'мг/ч', '(1 − η)·n·G_Fe', '', '')
S.add('m_si', 'SiO₂ в воздух цеха', 'm_SiO₂', '=(1-{eta})*{G_si}*{npost}*1000', 'мг/ч', '(1 − η)·n·G_SiO₂', '', '')
S.note('Оседание аэрозоля (коэффициент 0,4 по Методике, разд. 2.3) в базовом расчёте НЕ учитывается — это запас. Вариант с оседанием посчитан в ядре (лист 9).')

# =====================================================================================================
# 3. СП 60
S = CalcSheet('3 СП 60', 'Воздухообмен по СП 60.13330.2020 (ассимиляция вредных веществ)',
              'Формула СП 60 (та же — СНиП 2.04.05-91*, прил. 17): L = L_wz + (m_по − L_wz·(q_wz − q_пр)) / (q_l − q_пр). '
              'L — сколько всего воздуха надо удалить из цеха (= подать притоком). Сюда входят и местные отсосы L_wz, поэтому общеобменная = L − L_wz.')
S.section('Марганец (лимитирующее вещество)')
S.add('Lwz', 'Воздух, удаляемый местными отсосами', 'L_wz', '={Qpost}*{npost}', 'м³/ч', 'L_wz = n·Q_тр', 'Отсосы уносят воздух из цеха вместе с остатком дыма — этот воздух тоже участвует в разбавлении.', 'СП 60.13330.2020 [Н]')
S.add('qwz', 'Допустимая концентрация в рабочей зоне', 'q_wz', '={pdk_mn}', 'мг/м³', 'q_wz = ПДК', '', 'СП 60, ГОСТ 12.1.005-88 [Н]')
S.add('qin', 'Концентрация в приточном воздухе', 'q_пр', '={qin_mn}', 'мг/м³', '', '', '')
S.add('ql', 'Концентрация в воздухе, удаляемом из верхней зоны', 'q_l', '={qwz}', 'мг/м³', 'q_l = q_wz (допущение)', 'Принято, что воздух перемешан полностью. На деле сварочный дым поднимается и наверху концентрация больше — значит реальный расход меньше, допущение идёт в запас.', '[Д] — в запас')
S.add('L', 'Весь воздухообмен (приток = вся вытяжка)', 'L', '={Lwz}+({m_po}-{Lwz}*({qwz}-{qin}))/({ql}-{qin})', 'м³/ч', 'L = L_wz + (m_по − L_wz·(q_wz − q_пр))/(q_l − q_пр)', 'Сколько воздуха надо удалить всего, чтобы марганца было не больше ПДК.', 'СП 60.13330.2020 [Н]')
S.add('Lov', 'Общеобменная вытяжка (сверх местных отсосов)', 'L_оо', '=MAX(0,{L}-{Lwz})', 'м³/ч', 'L_оо = L − L_wz', 'Столько должен удалять вентилятор общеобменной вентиляции.', '')
S.add('Lsimple', 'Проверка: при q_l = q_wz формула упрощается', 'L', '={m_po}/({qwz}-{qin})', 'м³/ч', 'L = m_по/(q_wz − q_пр)', 'Должно совпасть с L выше — значит формула введена верно.', 'алгебра')
S.add('Cchk', 'Проверка: концентрация при найденном L', 'C', '={qin}+{m_po}/{L}', 'мг/м³', 'C = q_пр + m_по/L', 'Должно получиться ровно ПДК (0,2).', 'баланс массы')
S.add('Lold', 'Как было в модели до 11.10.2026 (ОШИБКА для центральной вытяжки)', 'L_оо,стар', '={m_po}/({qwz}-{qin})', 'м³/ч', 'L_оо = m_по/(ПДК − q_пр)', 'Весь потребный воздух отдавали общеобменной и ещё добавляли местные отсосы сверху — воздух отсосов считался дважды. Для схемы с возвратом воздуха (диплом) эта формула верна — см. ниже.', 'ошибка — в запас')
S.add('Lover', 'Перерасход из-за ошибки', 'ΔL', '={Lold}-{Lov}', 'м³/ч', 'L_оо,стар − L_оо', 'Ровно расход местных отсосов.', '')
S.section('Другие вещества — проверка, что лимитирует марганец')
S.add('L_fe', 'Весь воздухообмен по железа оксиду', 'L_Fe', '={m_fe}/({pdk_fe}-{qin_fe})', 'м³/ч', 'L = m/(ПДК − q_пр)', 'Меньше, чем по марганцу — значит определяет марганец.', 'СП 60 [Н]')
S.add('L_si', 'Весь воздухообмен по SiO₂', 'L_SiO₂', '={m_si}/{pdk_si}', 'м³/ч', 'L = m/ПДК', '', 'СП 60 [Н]')
S.add('Lmax', 'Расчётный (наибольший)', 'L_расч', '=MAX({L},{L_fe},{L_si})', 'м³/ч', 'max по веществам', 'Если вещества однонаправленного действия — по СП 60 расходы СКЛАДЫВАЮТСЯ (Σ m_i/(ПДК_i − q_пр,i)). Mn, Fe₂O₃ и SiO₂ к одной группе не относятся.', 'СП 60.13330.2020 [Н]')
S.section('Схема диплома: переносной электрофильтр с возвратом очищенного воздуха в цех (L_wz = 0)')
S.add('etafr', 'Степень очистки аэрозоля фильтром агрегата', 'η_ф', 1.0, '—', '', '1 — идеальный фильтр. Реальное значение — из паспорта агрегата. Газы (HF, CO, NO₂) электрофильтр не задерживает: для них η_ф = 0.', 'паспорт [Д]', 'in', '0.00')
S.add('m_rec', 'Mn в воздух цеха: мимо отсоса + проскок фильтра', 'm_по', '=(1-{eta}+{eta}*(1-{etafr}))*{G_mn_all}', 'мг/ч', 'm = [(1 − η) + η(1 − η_ф)]·ΣG', 'Фильтр возвращает воздух в цех вместе с тем, что не поймал.', 'баланс массы')
S.add('L_rec', 'Весь воздухообмен = общеобменная (отсосы воздух не удаляют)', 'L = L_оо', '={m_rec}/({qwz}-{qin})', 'м³/ч', 'L = m/(q_wz − q_пр), L_wz = 0', 'При η_ф = 1 — ровно столько же воздуха, сколько при центральной вытяжке (L выше). Значит, и тепло то же. Разница — только кто удаляет воздух.', 'СП 60 [Н]')
S.add('L_rec_ratio', 'Во сколько раз больше, чем при выбросе наружу', '', '={L_rec}/{L}', '—', '', 'При η_ф = 0,95 → 1,2 раза.', '')
S.note('Норматив: СНиП 41-01-2003, п. 7.4.4 — рециркуляция не допускается из систем местных отсосов вредных веществ; исключение — местные отсосы пылевоздушных смесей после очистки от пыли. Для сварочного аэрозоля с Mn (2-й класс) и газами — сверить по действующему СП 60.13330.2020, разд. 7.4 [П].')
S.section('Что ещё требует СП 60 и как это учтено')
S.note('1) Расходы определяются отдельно для тёплого и холодного периодов — в модели считается холодный (по нему максимальные затраты тепла). 2) Теплопоступления от дуги на расход по вредным веществам не влияют (одинаковы во всех режимах) — не моделируются. '
       '3) Рециркуляция не применяется: Mn — 2-й класс опасности. 4) Минимум наружного воздуха на человека (СП 60, прил. [П: номер]) — десятки м³/ч; у нас ≥ 1500 м³/ч на сварщика — выполняется с большим запасом. '
       '5) Местные отсосы и общеобменная вытяжка компенсируются притоком того же расхода — поэтому тепло считается от L (лист 7).')

