# -*- coding: utf-8 -*-
"""Сборка книги «Модель_расчёт_v2.xlsx» — расчёт вручную (формулами Excel) всех стационарных частей модели
и сверка с расчётным ядром (engine.json выгружает export_engine.ts).
Цвета: синий — исходные данные (меняются), чёрный — формулы, зелёный — ссылка на другой лист, оранжевая заливка — значения из ядра для сверки."""
import json, math
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.comments import Comment
from openpyxl.utils import get_column_letter

E = json.load(open('/home/claude/model/v2/engine.json'))
OUT = '/home/claude/model/Модель_расчёт_v2.xlsx'

F = 'Arial'
f_in = Font(name=F, color='0000FF'); f_fx = Font(name=F, color='000000'); f_ln = Font(name=F, color='008000')
f_b = Font(name=F, bold=True); f_h = Font(name=F, bold=True, size=13); f_n = Font(name=F); f_i = Font(name=F, italic=True, color='555555')
fill_in = PatternFill('solid', fgColor='FFF2CC'); fill_eng = PatternFill('solid', fgColor='FCE4D6'); fill_hd = PatternFill('solid', fgColor='D9E1F2')
fill_ok = PatternFill('solid', fgColor='E2EFDA')
thin = Side(style='thin', color='BBBBBB'); BOX = Border(left=thin, right=thin, top=thin, bottom=thin)
WRAP = Alignment(wrap_text=True, vertical='top')

wb = Workbook()
REF = {}   # имя -> абсолютная ссылка 'Лист'!$D$n


def q(sheet):
    return "'" + sheet + "'"


def setw(ws, widths):
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w


def header(ws, row, cols):
    for j, c in enumerate(cols, 1):
        x = ws.cell(row=row, column=j, value=c); x.font = f_b; x.fill = fill_hd; x.alignment = WRAP; x.border = BOX


class CalcSheet:
    """Лист «строка = величина»: A №, B величина, C обозначение, D значение, E ед., F формула словами, G простыми словами, H источник"""
    COLS = ['№', 'Величина', 'Обозн.', 'Значение', 'Ед.', 'Формула (как в книге)', 'Простыми словами — что это и зачем', 'Источник / статус']

    def __init__(self, title, heading, intro):
        self.ws = wb.create_sheet(title); self.title = title; self.r = 1; self.n = 0
        self.ws.cell(row=1, column=1, value=heading).font = f_h
        self.ws.cell(row=2, column=1, value=intro).font = f_i
        self.ws.merge_cells(start_row=2, start_column=1, end_row=2, end_column=8)
        self.ws.cell(row=2, column=1).alignment = WRAP; self.ws.row_dimensions[2].height = 60
        header(self.ws, 4, self.COLS); self.r = 5
        setw(self.ws, [5, 34, 10, 14, 9, 34, 60, 40])
        self.ws.freeze_panes = 'A5'

    def section(self, text):
        c = self.ws.cell(row=self.r, column=1, value=text); c.font = f_b
        self.ws.merge_cells(start_row=self.r, start_column=1, end_row=self.r, end_column=8); self.r += 1

    def add(self, name, label, sym, value, unit, formula_txt, plain, src, kind='fx', fmt='0.000'):
        """value: число (исходное) или строка-формула с {имена}. kind: in — ввод, fx — формула, eng — значение из ядра"""
        ws, r = self.ws, self.r
        self.n += 1
        ws.cell(row=r, column=1, value=self.n).font = f_n
        ws.cell(row=r, column=2, value=label).font = f_n
        ws.cell(row=r, column=3, value=sym).font = f_n
        v = value.format(**REF) if isinstance(value, str) else value
        c = ws.cell(row=r, column=4, value=v)
        c.number_format = fmt
        if kind == 'in': c.font = f_in; c.fill = fill_in
        elif kind == 'eng': c.font = f_in; c.fill = fill_eng
        else: c.font = f_ln if (isinstance(v, str) and '!' in v and v.count('!') == 1 and v.startswith("='")) else f_fx
        ws.cell(row=r, column=5, value=unit).font = f_n
        ws.cell(row=r, column=6, value=formula_txt).font = f_n
        ws.cell(row=r, column=7, value=plain).font = f_n
        ws.cell(row=r, column=8, value=src).font = f_n
        for j in range(1, 9):
            ws.cell(row=r, column=j).alignment = WRAP; ws.cell(row=r, column=j).border = BOX
        if name:
            REF[name] = q(self.title) + '!$D$' + str(r)
        self.r += 1
        return r

    def note(self, text):
        c = self.ws.cell(row=self.r, column=2, value=text); c.font = f_i; c.alignment = WRAP
        self.ws.merge_cells(start_row=self.r, start_column=2, end_row=self.r, end_column=8)
        self.ws.row_dimensions[self.r].height = max(15, 15 * (1 + len(text) // 140)); self.r += 1


# =====================================================================================================
# 0. КАК ЧИТАТЬ
ws = wb.active; ws.title = 'Как читать'
setw(ws, [4, 120])
lines = [
    ('Книга «Модель расчёт v2» — стационарная часть математической модели местной вытяжной вентиляции сварочного участка', f_h),
    ('Версия 11.10.2026. Каждая цифра здесь считается формулой Excel — можно поменять синюю ячейку и увидеть, как меняется всё остальное.', f_n),
    ('', f_n),
    ('ЦВЕТА', f_b),
    ('Синий шрифт на жёлтом — исходные данные (их можно менять). У каждого — источник в последней колонке.', f_in),
    ('Чёрный шрифт — формула. Зелёный — формула-ссылка на ячейку другого листа.', f_n),
    ('Оранжевая заливка — число, которое посчитало расчётное ядро (программа на TypeScript, папка vent-sim). Нужно только для сверки на листе «8 Сверка».', f_n),
    ('', f_n),
    ('СТАТУСЫ ИСТОЧНИКОВ', f_b),
    ('[Н] — норматив РФ (ГОСТ, СП, СанПиН, методика из перечня Минприроды).  [С] — российский справочник или учебник.', f_n),
    ('[Д] — допущение демонстрационного примера (заменяется паспортом оборудования реального объекта).  [А] — параметр, выбранный автором (проверена чувствительность).', f_n),
    ('[П] — источник найден, но страницу/таблицу надо сверить по бумажной книге.  [М] — инженерная модель (приём расчёта, не норматив).', f_n),
    ('', f_n),
    ('ПОРЯДОК ЛИСТОВ = ПОРЯДОК РАСЧЁТА', f_b),
    ('1 Исходные — все входные величины в одном месте.', f_n),
    ('2 Выделения — сколько вредных веществ выделяет сварка: расход проволоки от тока → граммы в час каждого вещества → сколько ловит отсос, сколько уходит в цех.', f_n),
    ('3 СП 60 — сколько воздуха надо подать в цех, чтобы концентрация не превысила ПДК (формула СП 60.13330.2020). Главное: местные отсосы тоже уносят воздух из цеха, их расход вычитается.', f_n),
    ('4 Таблицы Идельчика — заслонка ζ(α) (диагр. 9-17), коэффициент A₁ отвода (диагр. 6-1), диффузор при n = 2 (диагр. 5-2).', f_n),
    ('5 Потери — потери давления на КАЖДОМ элементе сети (зонт, воздуховод, отводы, заслонка, тройники, переходы, фильтр, выход) при пусконаладочном режиме 3 × 1500 м³/ч.', f_n),
    ('   Там же проверка: по закону сохранения энергии сумма потерь по пути от любого поста до выброса должна равняться давлению вентилятора.', f_n),
    ('6 Вентилятор — давление по характеристике и законам подобия, мощность на валу, КПД двигателя и частотника, электрическая мощность.', f_n),
    ('7 Тепло — сколько тепла уходит на нагрев приточного воздуха (весь удалённый воздух замещается подогретым наружным).', f_n),
    ('8 Сверка — Excel против ядра: если разница < 0,1 %, ячейка зелёная.', f_n),
    ('9 Результаты смены — итоги динамического расчёта 8-часовой смены (в Excel их не повторить: нужен шаг по времени 1 с × 28 800 шагов, это делает ядро).', f_n),
    ('', f_n),
    ('ЧЕГО В EXCEL НЕТ И ПОЧЕМУ', f_b),
    ('Решение сети (какой расход установится при данных углах заслонок) — это система нелинейных уравнений, её решает ядро методом Ньютона. Excel берёт готовые расходы постов и ПРОВЕРЯЕТ, что они действительно решение (баланс давлений по всем путям).', f_n),
    ('Регуляторы (ПИ-регулятор заслонок, частотник, общеобменная по датчикам) работают во времени — только в ядре. Их результаты — лист 9.', f_n),
    ('', f_n),
    ('ЧТО ИСПРАВЛЕНО 11.10.2026 (честно)', f_b),
    ('1. Общеобменная вентиляция считалась без учёта воздуха местных отсосов (L_wz в формуле СП 60). Ошибка в запас, но завышала общеобменную на 4500 м³/ч (3 поста): 12 601 → 8 101 м³/ч. В дипломе это не ошибка: там переносной электрофильтр возвращает воздух в цех (L_wz = 0) — см. лист 3, последний раздел.', f_n),
    ('   Следствие: прежние цифры экономии тепла от общеобменной по потребности (−37…−56 %) были завышены. Пересчитано (лист 9).', f_n),
    ('2. Боковой вход тройника: в формуле Идельчика есть поправка A (0,55…1 в зависимости от F_б/F_с и Q_б/Q_с). Было A = 1 — завышало потери бокового входа до 1,8 раза при F_б/F_с > 0,35.', f_n),
    ('3. Энергия вентилятора общеобменной: при регулировании по выделениям расход бывает больше расчётного; вентилятор теперь подбирается на максимальный расход (иначе мощность считалась при нереальном давлении).', f_n),
]
for i, (t, fnt) in enumerate(lines, 1):
    c = ws.cell(row=i, column=2, value=t); c.font = fnt; c.alignment = WRAP

