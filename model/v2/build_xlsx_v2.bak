# диффузор n = 2
wsZ.cell(row=31, column=1, value='Диффузор круглый в сети, ζ_д при n = F₁/F₀ = 2, l₀/D₀ = 0 — Идельчик, 1992, диагр. 5-2, с. 211, сверено. Строки — Re·10⁻⁵, столбцы — α, °').font = f_b
DA = [3, 4, 6, 8, 10, 12, 14, 16, 20, 30, 45, 60, 90, 120, 180]; DR = [0.5e5, 1e5, 2e5, 4e5]
DZ = [[0.148, 0.135, 0.121, 0.112, 0.107, 0.109, 0.120, 0.141, 0.191, 0.315, 0.331, 0.326, 0.315, 0.308, 0.298],
      [0.120, 0.106, 0.090, 0.083, 0.080, 0.088, 0.102, 0.122, 0.196, 0.298, 0.297, 0.286, 0.283, 0.279, 0.276],
      [0.093, 0.082, 0.070, 0.068, 0.062, 0.062, 0.063, 0.073, 0.120, 0.229, 0.279, 0.268, 0.268, 0.265, 0.263],
      [0.079, 0.068, 0.056, 0.048, 0.048, 0.048, 0.051, 0.051, 0.068, 0.120, 0.271, 0.272, 0.272, 0.268, 0.268]]
wsZ.cell(row=32, column=1, value='Re').font = f_b; wsZ.cell(row=32, column=2, value='ln Re').font = f_b
